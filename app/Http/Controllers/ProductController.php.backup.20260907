<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Throwable;
use App\Models\CachedProduct;
use Carbon\Carbon;
use App\Services\DigiKeyService;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Log;

class ProductController extends Controller
{
    const CACHE_PAGE_TTL    = 60 * 60 * 6;   // 6 hours
    const CACHE_SIMILAR_TTL = 60 * 60 * 12;  // 12 hours
    const CACHE_SEO_TTL     = 60 * 60 * 24;  // 24 hours
    const CACHE_SPECS_TTL   = 60 * 60 * 24;  // 24 hours

    public function show($manufacturer, $part = null)
    {
        try {

            // ── 1. Normalize the part number from URL ─────────────────────
            if (request()->has('part')) {
                $queryPart = strtoupper(trim(request('part')));
                $safePart  = str_replace('/', '__', $queryPart);
                if (!$part || $part !== $safePart) {
                    return redirect(url('product/' . $manufacturer . '/' . $safePart), 301);
                }
            }

            if ($part) {
                $part = rawurldecode($part);
                $part = str_replace(['__', '--'], ['/', '#'], $part);
                $part = strtoupper(trim($part));
            } else {
                $part = request('part');
            }

            if (!$part) {
                // Manufacturer-only URL (no MPN) — not a valid product page.
                // Redirect to search instead of hard 404ing, since Google has
                // indexed/crawled a meaningful number of these.
                return redirect('/available-stock?search=' . urlencode(str_replace('-', ' ', $manufacturer)), 301);
            }

            $normalized = strtoupper(trim($part));

            // ── 2. Detect bots early ──────────────────────────────────────
            $userAgent = strtolower(request()->userAgent() ?? '');
            $isBot     = (bool) preg_match('/bot|crawl|slurp|spider|mediapartners-google/i', $userAgent);

            // ── 3. Load cached product (DB) ───────────────────────────────
            $cacheKey = 'product_record_' . md5($normalized);

            $cached = Cache::remember($cacheKey, self::CACHE_PAGE_TTL, function () use ($normalized) {

                $record = CachedProduct::where('product_key', $normalized)
                    ->orWhere('name', $normalized)
                    ->first();

                if (!$record && str_contains($normalized, '#')) {
                    $alt    = explode('#', $normalized)[0];
                    $record = CachedProduct::where('product_key', 'LIKE', $alt . '%')->first();
                }

                return $record;
            });

            if (!$cached) {
                abort(404);
            }

            // ── 4. Decode product JSON once ───────────────────────────────
            $product = is_array($cached->raw_data)
                ? $cached->raw_data
                : json_decode($cached->raw_data, true);

            unset($product['Price'], $product['UnitPrice'], $product['StandardPricing']);

            if (!empty($product['Description']) && is_array($product['Description'])) {
                $product['Description'] = $product['Description']['ProductDescription'] ?? null;
            }
            if (!empty($product['Manufacturer']) && is_array($product['Manufacturer'])) {
                $product['Manufacturer'] = $product['Manufacturer']['Name'] ?? null;
            }
            if (!empty($product['Category']) && is_array($product['Category'])) {
                $product['Category'] = $product['Category']['Name'] ?? null;
            }
            if (empty($product['ManufacturerPartNumber'])) {
                $product['ManufacturerPartNumber'] = $cached->name;
            }
            if (empty($product['DataSheetUrl']) && !empty($cached->datasheet)) {
                $product['DataSheetUrl'] = $cached->datasheet;
            }

            // ── 5. Quantity ───────────────────────────────────────────────
            if ((int) $cached->quantity === 0) {
                $cached->quantity = rand(3000, 15000);
                CachedProduct::where('id', $cached->id)
                    ->update(['quantity' => $cached->quantity]);
                Cache::forget($cacheKey);
            }

            $quantity = (int) $cached->quantity;

            // ── 6. Similar products ───────────────────────────────────────
            $similarKey      = 'similar_' . md5($cached->product_key . $cached->category . $cached->manufacturer);
            $similarProducts = Cache::remember($similarKey, self::CACHE_SIMILAR_TTL, function () use ($cached) {

                $results = CachedProduct::where('category', $cached->category)
                    ->where('manufacturer', $cached->manufacturer)
                    ->where('product_key', '!=', $cached->product_key)
                    ->limit(5)
                    ->get();

                if ($results->count() < 5) {
                    $extra = CachedProduct::where('category', $cached->category)
                        ->where('product_key', '!=', $cached->product_key)
                        ->whereNotIn('id', $results->pluck('id'))
                        ->limit(5 - $results->count())
                        ->get();
                    $results = $results->merge($extra);
                }

                if ($results->count() < 5) {
                    $extra = CachedProduct::where('product_key', '!=', $cached->product_key)
                        ->whereNotIn('id', $results->pluck('id'))
                        ->latest()
                        ->limit(5 - $results->count())
                        ->get();
                    $results = $results->merge($extra);
                }

                return $results;
            });

            // ── 7. Specs ──────────────────────────────────────────────────
            // FIX: We no longer use Cache::get() + manual put() with an
            // empty [] sentinel. That pattern caused stale empty cache
            // entries to persist after the admin saved specs via the editor,
            // because nothing ever busted the 'specs_*' key.
            //
            // New rules:
            //   • specs_synced = 1 AND specs non-empty  → serve from DB, cache 24h
            //   • specs_synced = 1 AND specs empty      → API confirmed none exist,
            //                                             cache empty 1h (no API call)
            //   • specs_synced = 0 AND real user        → call DigiKey API, save to DB
            //   • specs_synced = 0 AND bot              → serve empty, no API call
            //
            // The admin SpecsController::save() must call Cache::forget() on
            // both keys below so edits are reflected immediately.

            $specsKey = 'specs_' . md5($cached->product_key);
            $specs    = Cache::get($specsKey); // null = not cached yet

            if ($specs === null) {

                // Always read fresh from DB so admin edits are never stale
                $dbSpecs = is_array($cached->specs)
                    ? $cached->specs
                    : json_decode($cached->specs, true);

                $hasSpecs = !empty($dbSpecs) && is_array($dbSpecs) && count($dbSpecs) > 0;

                if ($hasSpecs) {
                    // ✅ DB has specs — cache and serve directly.
                    // No invalidation check here: the admin editor is the
                    // source of truth. If specs look wrong the editor should
                    // be used to fix them, not silent auto-deletion.
                    Cache::put($specsKey, $dbSpecs, self::CACHE_SPECS_TTL);
                    $specs = $dbSpecs;

                } elseif ((int) $cached->specs_synced === 1) {
                    // ✅ API was already called and confirmed no specs exist.
                    // Cache empty 1h to avoid hammering the API.
                    Cache::put($specsKey, [], 60 * 60);
                    $specs = [];

                } elseif ($isBot) {
                    // ⚡ Bot + specs missing + never synced → serve empty,
                    // NO API call. This rule was documented above but never
                    // implemented, so every bot crawl of an unsynced product
                    // was triggering a live, synchronous DigiKey API call —
                    // a likely contributor to the LVE process-cap breaches.
                    $specs = [];

                } else {
                    // ⚡ Real user + specs missing + never synced → call API
                    try {
                        $digikey = new DigiKeyService();
                        $result  = $digikey->fetchProductSpecs($cached->product_key);

                        $freshSpecs = $result['specs'] ?? null;
                        $rawData    = $result['raw']   ?? null;

                        if (!empty($freshSpecs)) {
                            $normalizedSpecs = collect($freshSpecs)
                                ->map(fn($s) => [
                                    'name'  => $s['name']  ?? $s['ParameterText'] ?? null,
                                    'value' => $s['value'] ?? $s['ValueText']     ?? null,
                                ])
                                ->filter(fn($s) => !empty($s['name']) && !empty($s['value']))
                                ->values()
                                ->toArray();

                            if (!empty($normalizedSpecs)) {
                                CachedProduct::where('id', $cached->id)->update([
                                    'specs'        => json_encode($normalizedSpecs),
                                    'digikey_raw'  => json_encode($rawData),
                                    'specs_synced' => 1,
                                ]);
                                Cache::put($specsKey, $normalizedSpecs, self::CACHE_SPECS_TTL);
                                $specs = $normalizedSpecs;
                            } else {
                                // API returned a response but had no spec rows
                                CachedProduct::where('id', $cached->id)
                                    ->update(['specs_synced' => 1]);
                                Cache::put($specsKey, [], 60 * 60);
                                $specs = [];
                            }
                        } else {
                            // API returned nothing — don't cache, retry next visit
                            Log::info('DigiKey returned no specs for ' . $cached->product_key);
                            $specs = [];
                        }

                    } catch (\Throwable $e) {
                        // API failed — don't cache, retry next real user visit
                        Log::warning('DigiKey specs fetch failed for ' . $cached->product_key . ': ' . $e->getMessage());
                        $specs = [];
                    }

                }

                // Fallback: parse basic key/value pairs from description text
                if (empty($specs) && !empty($product['Description'])) {
                    $desc = trim(preg_replace('/\s+/', ' ', strip_tags($product['Description'])));
                    $desc = preg_replace('/digi[-\s]?key/i', '', $desc);
                    preg_match_all(
                        '/([A-Za-z][A-Za-z0-9\-\s]{2,}?)\s*(?::|\s-\s)\s*([^;,]+?)(?=\s{2,}|;|,|$)/',
                        $desc, $matches, PREG_SET_ORDER
                    );
                    $specs = collect($matches)
                        ->map(fn($m) => ['name' => trim($m[1]), 'value' => trim($m[2])])
                        ->filter(fn($s) => !empty($s['name']) && !empty($s['value']))
                        ->unique(fn($s) => strtolower($s['name']))
                        ->values()
                        ->toArray();

                    if (!empty($specs)) {
                        Cache::put($specsKey, $specs, 60 * 60 * 6);
                    }
                }
            }

            // ── 8. Clean source references ────────────────────────────────
            $cleanSource = function ($data) use (&$cleanSource) {
                if (is_array($data)) {
                    return array_map($cleanSource, $data);
                }
                if (is_string($data)) {
                    $data = str_ireplace(['digikey', 'digi-key', 'digi key'], '', $data);
                    $data = preg_replace('/\bat\s+Simplytronix\b/i', '', $data);
                    $data = preg_replace('/\bat\s*$/i', '', $data);
                    return trim(preg_replace('/\s+/', ' ', $data));
                }
                return $data;
            };

            $product         = $cleanSource($product);
            $specs           = $cleanSource($specs ?? []);
            $similarProducts = $similarProducts->map(function ($item) {
                $item->description = str_ireplace(
                    ['digikey', 'digi-key', 'digi key'], '', $item->description ?? ''
                );
                return $item;
            });

            $cached->digikey_raw = $cleanSource(
                is_array($cached->digikey_raw)
                    ? $cached->digikey_raw
                    : json_decode($cached->digikey_raw, true)
            );

            if (!empty($product['ProductStatus']['Status'])) {
                $s = $product['ProductStatus']['Status'];
                $s = str_ireplace(['digikey', 'digi-key', 'digi key'], '', $s);
                $s = preg_replace('/\bat\s+Simplytronix\b/i', '', $s);
                $s = preg_replace('/\bat\s*$/i', '', $s);
                $product['ProductStatus']['Status'] = trim(preg_replace('/\s+/', ' ', $s));
            }

            if (!empty($product['SuggestedReplacement'])) {
                $product['SuggestedReplacement'] =
                    preg_replace('/^[0-9]+-/', '', $product['SuggestedReplacement']);
            }

            // ── 9. SEO variables ──────────────────────────────────────────
            $actualManufacturer = $cached->manufacturer ?? 'N/A';
            $mpn       = $cached->product_key ?? $product['ManufacturerPartNumber'] ?? '';
            $category  = $cached->category    ?? $product['Category'] ?? '';
            $rohs      = $product['RohsInfo'] ?? $product['RoHSStatus'] ?? '';
            $lifecycle = $product['ProductStatus']['Status'] ?? '';

            $description = $this->generateDynamicDescription($mpn, $actualManufacturer, $category, $specs);

            // Short fragment (spec highlights only, no MPN/manufacturer/category
            // restatement) — used for the {digikey_desc} token in the meta
            // description template, which already states those identity fields
            // itself. Using $description here was producing "Buy X by Y. X is
            // a ... component from Y with ..." — the same three facts stated
            // three times before any useful content, all of which was getting
            // truncated away by Google's ~155 char SERP cutoff.
            $metaFragment = $this->generateMetaDescriptionFragment($specs);

            $priceText  = 'Contact for Pricing'; // reflects your actual policy, reads coherently
$intentText = $quantity > 0 ? 'In Stock. Ships same day.' : 'Sourced to order. Contact us for lead time.';

            $datasheetAvailable = !empty($product['DataSheetUrl']);
            $dynamicOverview = $this->generateDynamicOverview(
                $mpn, $actualManufacturer, $category, $specs, $rohs, ($product['LeadTime'] ?? ''), $datasheetAvailable
            );

            // ── 10. SEO settings ──────────────────────────────────────────
            $seo = Cache::remember('seo_settings', self::CACHE_SEO_TTL, function () {
                return DB::table('seo_settings')->first();
            });

            $templateTitle = $seo->seo_title_template       ?? '';
            $templateDesc  = $seo->seo_description_template ?? '';

            $replace = [
                '{manufacturer}' => $actualManufacturer,
                '{mpn}'          => $mpn,
                '{category}'     => $category,
                '{price}'        => $priceText,
                '{stock}'        => $intentText,
                '{rohs}'         => $rohs,
                '{lifecycle}'    => $lifecycle,
                '{digikey_desc}' => $metaFragment,
                '{description}'  => $description,
            ];

            $generatedTitle = trim(preg_replace('/\s+/', ' ', strtr($templateTitle, $replace)));

            if (strlen($generatedTitle) > 60) {
                $shortReplace               = $replace;
                $shortReplace['{category}'] = '';
                $generatedTitle = trim(preg_replace('/\s+/', ' ', strtr($templateTitle, $shortReplace)));
            }

            // Tier 2: drop manufacturer, keep MPN + brand suffix intact.
            // Never fall through to a blind substr() here — that was cutting
            // mid-word into "Simplytronix" itself for long MPN/manufacturer
            // combos (e.g. "...Buy Now At Sim...").
            if (strlen($generatedTitle) > 60) {
                $titleSuffix    = ' | Simplytronix';
                $generatedTitle = trim($mpn) . $titleSuffix;
            }

            // Tier 3 (extreme case): trim the MPN itself, never the brand suffix.
            if (strlen($generatedTitle) > 60) {
                $titleSuffix    = ' | Simplytronix';
                $maxMpnLen      = 60 - strlen($titleSuffix);
                $generatedTitle = substr($mpn, 0, $maxMpnLen) . $titleSuffix;
            }

            $generatedDesc = trim(preg_replace('/\s+/', ' ', strtr($templateDesc, $replace)));

            if (empty($generatedTitle)) {
                $generatedTitle = trim("{$mpn} {$actualManufacturer} {$category} - Buy Online | Simplytronix");
            }

            if (empty($generatedDesc)) {
                $generatedDesc = trim(
                    "{$mpn} by {$actualManufacturer}"
                    . ($metaFragment ? " — {$metaFragment}." : '.')
                    . " {$intentText} Get a quote from Simplytronix."
                );
            }

            // Hard cap at 155 chars, trimmed on a word boundary — applies to
            // BOTH the DB-template path and the fallback path above, so a
            // long spec fragment can never produce a description that Google
            // truncates mid-word.
            if (strlen($generatedDesc) > 155) {
                $generatedDesc = substr($generatedDesc, 0, 155);
                $generatedDesc = substr($generatedDesc, 0, strrpos($generatedDesc, ' '));
                $generatedDesc = rtrim($generatedDesc, ' ,.-') . '.';
            }

            $seoTitle = !empty($cached->meta_title)       ? $cached->meta_title       : $generatedTitle;
            $seoDesc  = !empty($cached->meta_description) ? $cached->meta_description : $generatedDesc;

            // ── 11. Return view ───────────────────────────────────────────
            // NOTE: $description is always machine-generated boilerplate (see
            // generateDynamicDescription()) even when no real specs exist, so it
            // cannot be used as a content-quality signal. $hasRealSpecs is the
            // only genuine signal available at this point in the pipeline.
            $hasRealSpecs = !empty($specs) && (is_array($specs) || $specs instanceof \Countable) && count($specs) >= 3;
            $isThin       = !$hasRealSpecs;
            $robotsTag    = $isThin ? 'noindex, follow' : 'index, follow';

            return response()
                ->view('product_details', [
                    'product'         => $product,
                    'manufacturer'    => $actualManufacturer,
                    'similarProducts' => $similarProducts,
                    'quantity'        => $quantity,
                    'specs'           => $specs,
                    'cached'          => $cached,
                    'mpn'             => $mpn,
                    'category'        => $category,
                    'description'     => $description,
                    'priceText'       => $priceText,
                    'intentText'      => $intentText,
                    'rohs'            => $rohs,
                    'lifecycle'       => $lifecycle,
                    'seoTitle'        => $seoTitle,
                    'seoDesc'         => $seoDesc,
                    'dynamicOverview' => $dynamicOverview,
                    'robotsTag'       => $robotsTag,
                ])
                ->header('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400')
                ->header('X-Robots-Tag', $robotsTag);

        } catch (\Symfony\Component\HttpKernel\Exception\HttpException $e) {
            throw $e;

        } catch (\Throwable $e) {
            Log::error('ProductController@show error: ' . $e->getMessage(), [
                'url'   => request()->fullUrl(),
                'trace' => $e->getTraceAsString(),
            ]);
            abort(500);
        }
    }

    private function article($word)
    {
        $word = trim($word);
        if ($word === '') return 'a';
        return preg_match('/^[aeiou]/i', $word) ? 'an' : 'a';
    }

    private function generateDynamicDescription($mpn, $manufacturer, $category, $specs)
    {
        $skip = ['Mounting Type', 'Supplier Device Package', 'Package / Case'];
        $highlights = collect($specs)
            ->reject(fn($s) => in_array($s['name'] ?? '', $skip) || empty($s['value'] ?? null))
            ->reject(fn($s) => stripos($s['value'] ?? '', $s['name'] ?? '') !== false)
            ->take(3)
            ->map(fn($s) => "{$s['value']} {$s['name']}")
            ->implode(', ');
        $catLower = strtolower($category ?: 'component');
        $article = $this->article($catLower);
        return $highlights
            ? "{$mpn} is {$article} {$catLower} component from {$manufacturer} with {$highlights}."
            : "{$mpn} is {$article} {$catLower} component from {$manufacturer}.";
    }

    private function generateMetaDescriptionFragment($specs)
    {
        $skip = ['Mounting Type', 'Supplier Device Package', 'Package / Case'];
        return collect($specs)
            ->reject(fn($s) => in_array($s['name'] ?? '', $skip) || empty($s['value'] ?? null))
            ->reject(fn($s) => stripos($s['value'] ?? '', $s['name'] ?? '') !== false)
            ->take(2)
            ->map(fn($s) => strtolower(trim($s['value'])) . ' ' . strtolower($this->humanizeSpecName($s['name'])))
            ->implode(', ');
    }

    private function humanizeSpecName(string $name): string
    {
        $name  = preg_replace('/\s*\([^)]*\)\s*$/', '', $name);
        $name  = str_replace(' - ', ', ', $name);
        $name  = trim(preg_replace('/\s+/', ' ', $name));
        $name  = rtrim($name, ', ');
        $words = explode(' ', $name);
        $words = array_map(function ($w) {
            $core      = preg_replace('/[^A-Za-z0-9]/', '', $w);
            $isAcronym = $core !== '' && $core === strtoupper($core) && strlen($core) <= 6;
            return $isAcronym ? $w : strtolower($w);
        }, $words);

        return implode(' ', $words);
    }

    private function generateDynamicOverview($mpn, $manufacturer, $category, $specs, $rohs, $leadTime, $datasheetAvailable)
    {
        $skip = [
            'Mounting Type', 'Supplier Device Package', 'Package / Case',
            'Packaging', 'Standard Pack Qty',
        ];

        $highlightSpecs = collect($specs)
            ->reject(fn($s) => in_array($s['name'] ?? '', $skip) || empty($s['value'] ?? null))
            ->take(6)
            ->values();

        $seed = crc32($mpn);
        $catLower = strtolower($category ?: 'component');
        $article = $this->article($catLower);

        $openers = [
            "{$mpn} is {$article} {$catLower} manufactured by {$manufacturer}.",
            "Manufactured by {$manufacturer}, the {$mpn} is classified as {$article} {$catLower}.",
            "The {$mpn} from {$manufacturer} falls under the {$catLower} category.",
            "{$manufacturer}'s {$mpn} is a widely used {$catLower} in electronic designs.",
        ];
        $sentence1 = $openers[$seed % count($openers)];

        $sentence2 = '';
        if ($highlightSpecs->isNotEmpty()) {
            $phrases = $highlightSpecs->map(function ($s) {
                $label = $this->humanizeSpecName($s['name']);
                $value = trim($s['value']);
                $value = rtrim($value, ", ");
                return "a {$label} of {$value}";
            })->all();

            $last   = array_pop($phrases);
            $joined = empty($phrases)
                ? $last
                : implode(', ', $phrases) . ' and ' . $last;

            $specIntros = [
                "It features {$joined}.",
                "Key specifications include {$joined}.",
                "Notable characteristics of this part include {$joined}.",
                "This component is defined by {$joined}.",
            ];
            $sentence2 = $specIntros[($seed >> 3) % count($specIntros)];
        }

        $tail = [];
        if (!empty($rohs)) {
            $tail[] = strtolower($rohs) === 'rohs compliant' ? 'is RoHS compliant' : strtolower($rohs);
        }
        if (!empty($leadTime) && $leadTime !== 'NA') {
            $tail[] = "has a typical lead time of {$leadTime} from factory";
        }
        if ($datasheetAvailable) {
            $tail[] = 'ships with a full manufacturer datasheet available for download';
        }

        $sentence3 = '';
        if (!empty($tail)) {
            $tailLast   = array_pop($tail);
            $tailJoined = empty($tail) ? $tailLast : implode(', ', $tail) . ' and ' . $tailLast;
            $sentence3  = ucfirst("this part {$tailJoined}.");
        }

        $closers = [
            "Simplytronix stocks {$mpn} for same-day shipping with genuine parts guaranteed.",
            "You can source {$mpn} through Simplytronix, with fast shipping and verified authenticity.",
            "Simplytronix carries {$mpn} in stock, backed by a genuine parts guarantee and quick dispatch.",
            "Order {$mpn} from Simplytronix for authenticated stock and same-day order processing.",
        ];
        $sentence4 = $closers[($seed >> 6) % count($closers)];

        return trim(implode(' ', array_filter([$sentence1, $sentence2, $sentence3, $sentence4])));
    }
    private function detectParent($category)
    {
        $category = strtolower($category);

        if (str_contains($category, 'resistor')   ||
            str_contains($category, 'capacitor')  ||
            str_contains($category, 'inductor')   ||
            str_contains($category, 'crystal')    ||
            str_contains($category, 'oscillator')) {
            return 'Passive Components';
        }
        if (str_contains($category, 'sensor') || str_contains($category, 'measurement')) {
            return 'Sensors & Measurement';
        }
        if (str_contains($category, 'rf') || str_contains($category, 'wireless') || str_contains($category, 'antenna')) {
            return 'RF & Wireless';
        }
        if (str_contains($category, 'connector') || str_contains($category, 'terminal') ||
            str_contains($category, 'socket')    || str_contains($category, 'header')   ||
            str_contains($category, 'plug')) {
            return 'Connectors';
        }
        if (str_contains($category, 'led') || str_contains($category, 'lighting') || str_contains($category, 'display')) {
            return 'Lighting & LEDs';
        }
        if (str_contains($category, 'hardware') || str_contains($category, 'mounting') || str_contains($category, 'spacer')) {
            return 'Hardware';
        }
        if (str_contains($category, 'evaluation') || str_contains($category, 'development')) {
            return 'Development Tools';
        }
        if (str_contains($category, 'power')     || str_contains($category, 'voltage') ||
            str_contains($category, 'regulator') || str_contains($category, 'converter')) {
            return 'Power & Power Management';
        }

        return 'Other';
    }
}